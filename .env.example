# Address that receives demo payments. Defaults to src/config.ts's demo merchant.
VITE_MERCHANT_ADDRESS=0xDaa1eb83E7D34435B004189906DdC53A0269854c

# Dev only. Inject a throwaway-key wallet as window.ethereum so the ADI flow can
# be demoed and tested without a browser extension. Never set this in a deploy:
# it puts a private key in the bundle. Fund the address from the ADI faucet.
VITE_DEV_WALLET_KEY=
